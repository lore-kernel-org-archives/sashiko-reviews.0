 			      struct kvm_io_device *dev);
 struct kvm_io_device *kvm_io_bus_get_dev(struct kvm *kvm, enum kvm_bus bus=
_idx,
+					 bool (*filter)(struct kvm_io_device *),
 					 gpa_t addr);
=20
 #ifdef CONFIG_KVM_ASYNC_PF
